# Proveedor de IA: gemini, groq, openrouter, deepseek u openai
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.8-flash

# Opcional: URL base personalizada para cualquier API compatible con OpenAI
AI_BASE_URL=

# Identidad y contexto del negocio
BUSINESS_NAME=Mi negocio
BUSINESS_SECTOR=Servicios
BUSINESS_DESCRIPTION=Describe brevemente el negocio y su propuesta de valor.
BUSINESS_PRODUCTS=Producto o servicio principal
BUSINESS_TONE=Claro, cordial y profesional
BUSINESS_POLICIES=Agrega aquí políticas, condiciones y límites relevantes.
BUSINESS_HOURS=Indica los días y horarios de atención.
BUSINESS_CONTACT=Indica los canales de contacto disponibles.
BUSINESS_INSTRUCTIONS=Agrega aquí instrucciones adicionales para el asistente.

# Límites de la API
MAX_HISTORY_MESSAGES=30
MAX_MESSAGE_LENGTH=4000
